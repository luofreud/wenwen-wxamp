<!-- pages/index/index.wxml -->
<view
  wx:if="{{navigationReady}}"
  class="home-page"
  style="height: {{pageHeight}}px; min-height: {{pageHeight}}px; max-height: {{pageHeight}}px;"
>
  <view
    class="navigation-bar"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <image
      class="navigation-title"
      src="/assets/images/title-bar.png"
      mode="scaleToFill"
      aria-label="问问星座"
    />
  </view>

  <scroll-view
    class="home-scroll"
    style="height: {{scrollViewHeight}}px;"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{!dataReady}}" class="home-skeleton" aria-label="首页数据加载中">
      <view class="home-skeleton__mood" aria-hidden="true">
        <view class="skeleton-block skeleton-user"></view>
        <view class="home-skeleton__mood-body">
          <view class="skeleton-block skeleton-score"></view>
          <view class="home-skeleton__luck-grid">
            <view class="skeleton-block skeleton-luck"></view>
            <view class="skeleton-block skeleton-luck"></view>
            <view class="skeleton-block skeleton-luck"></view>
            <view class="skeleton-block skeleton-luck"></view>
          </view>
        </view>
      </view>

      <view class="home-skeleton__live" aria-hidden="true">
        <view class="skeleton-block skeleton-live-title"></view>
        <view class="skeleton-block skeleton-live-line"></view>
        <view class="skeleton-block skeleton-live-line skeleton-live-line--short"></view>
        <view class="home-skeleton__live-actions">
          <view class="skeleton-block skeleton-live-viewers"></view>
          <view class="skeleton-block skeleton-live-button"></view>
        </view>
      </view>

      <view class="skeleton-block home-skeleton__banner" aria-hidden="true"></view>

      <view class="home-skeleton__reports" aria-hidden="true">
        <view class="home-skeleton__report">
          <view class="home-skeleton__report-copy">
            <view class="skeleton-block skeleton-report-title"></view>
            <view class="skeleton-block skeleton-report-line"></view>
            <view class="skeleton-block skeleton-report-line skeleton-report-line--short"></view>
          </view>
          <view class="skeleton-block skeleton-report-cover"></view>
        </view>
        <view class="home-skeleton__report">
          <view class="home-skeleton__report-copy">
            <view class="skeleton-block skeleton-report-title"></view>
            <view class="skeleton-block skeleton-report-line"></view>
            <view class="skeleton-block skeleton-report-line skeleton-report-line--short"></view>
          </view>
          <view class="skeleton-block skeleton-report-cover"></view>
        </view>
        <view class="home-skeleton__report">
          <view class="home-skeleton__report-copy">
            <view class="skeleton-block skeleton-report-title"></view>
            <view class="skeleton-block skeleton-report-line"></view>
            <view class="skeleton-block skeleton-report-line skeleton-report-line--short"></view>
          </view>
          <view class="skeleton-block skeleton-report-cover"></view>
        </view>
      </view>
    </view>
    <view wx:else class="home-content">
  
  <view class="index-empty" wx:if="{{fortuneState === 'empty'}}">
    <archive-empty />
  </view>

  <view wx:else class="mood-card" bindtap="handleFortuneCardTap">
    <image
      class="mood-card__background"
      src="/assets/images/emo-background.png"
      mode="widthFix"
      aria-hidden="true"
    />
    <view class="mood-content">
      <view
        class="mood-mine-action"
        catchtap="switchToMine"
        role="button"
        aria-label="前往我的页面签到"
      ></view>
      <text class="user-name">{{fortuneUserName || '档案加载中…'}}</text>
      <view class="mood-columns">
        <view class="mood-overview">
          <view class="score-heading">
            <image
              class="score-background"
              src="/assets/images/score-background.png"
              mode="heightFix"
              aria-hidden="true"
            />
            <view class="score-title">
              <text class="score-title-label">今日心情</text>
              <text class="score-number">{{moodScoreText}}</text>
              <text class="score-unit">分</text>
            </view>
          </view>
          <view class="mood-bars">
            <view wx:for="{{moodBars}}" wx:key="label" class="mood-bar-item">
              <text class="bar-score">{{item.scoreText}}分</text>
              <view class="bar-track">
                <view
                  class="bar-fill bar-fill--{{item.tone}}"
                  style="{{item.heightStyle}}"
                ></view>
              </view>
              <text class="bar-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="luck-grid">
          <view wx:for="{{luckItems}}" wx:key="label" class="luck-card">
            <view class="luck-icon luck-icon--{{item.tone}}">
              <view wx:if="{{item.tone === 'color'}}" class="color-swatch"></view>
              <text wx:else>{{item.icon}}</text>
            </view>
            <view class="luck-copy">
              <text class="luck-value">{{item.value}}</text>
              <text class="luck-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{liveEvent}}" class="live-card">
    <image
      class="live-card__background"
      src="/assets/images/live-pre-backgroud.png"
      mode="widthFix"
      aria-hidden="true"
    />
    <view class="live-copy">
      <text class="live-title">{{liveEvent.title}}</text>
      <view class="live-description-wrap">
        <text class="live-description">{{liveEvent.description}}</text>
      </view>
      <view class="live-action-row">
        <view class="reservation-row">
          <view
            wx:if="{{liveEvent.reservation_count > 0}}"
            class="live-avatar-stack {{liveEvent.reservation_count > 4 ? 'live-avatar-stack--animated' : 'live-avatar-stack--' + liveEvent.reservation_count}}"
            aria-label="预约用户头像"
          >
            <view class="live-avatar-track {{liveEvent.reservation_count > 4 ? 'live-avatar-track--animated' : ''}} {{liveEvent.reservation_count > 4 && avatarShifting ? 'live-avatar-track--shifting' : ''}}">
              <image class="live-viewer-avatar" src="{{liveAvatarItems[0]}}" mode="aspectFill" aria-hidden="true" />
              <image wx:if="{{liveEvent.reservation_count > 1}}" class="live-viewer-avatar" src="{{liveAvatarItems[1]}}" mode="aspectFill" aria-hidden="true" />
              <image wx:if="{{liveEvent.reservation_count > 2}}" class="live-viewer-avatar" src="{{liveAvatarItems[2]}}" mode="aspectFill" aria-hidden="true" />
              <image wx:if="{{liveEvent.reservation_count > 3}}" class="live-viewer-avatar" src="{{liveAvatarItems[3]}}" mode="aspectFill" aria-hidden="true" />
              <image wx:if="{{liveEvent.reservation_count > 4}}" class="live-viewer-avatar" src="{{liveAvatarItems[4]}}" mode="aspectFill" aria-hidden="true" />
            </view>
          </view>
          <text class="reservation-count {{liveEvent.reservation_count === 0 ? 'reservation-count--solo' : ''}}">{{liveEvent.reservation_count}}人已预约</text>
        </view>
        <navigator
          class="reserve-button"
          url="{{liveEvent.detailUrl}}"
          hover-class="reserve-button--pressed"
        >{{liveEvent.reservation_status === 'reserved' ? '查看直播' : '去预约'}}</navigator>
      </view>
    </view>
  </view>

  <image
    class="app-banner"
    src="/assets/images/home-banner.png"
    mode="widthFix"
    aria-label="问问星座APP，真人专业解析"
  />

  <view wx:if="{{reports.length > 0}}" class="report-list">
    <view
      wx:for="{{reports}}"
      wx:key="type_code"
      class="report-card report-card--{{index + 1}}"
      hover-class="content-card--pressed"
    >
      <view class="report-copy">
        <text class="report-title">{{item.title}}</text>
        <view class="report-description-wrap">
          <text class="report-description">{{item.description}}</text>
        </view>
      </view>
      <image class="report-image" src="{{item.image}}" mode="aspectFit" />
    </view>
  </view>

  <view wx:if="{{moreReports.length > 0}}" class="more-section">
    <view class="more-heading">
      <image
        class="more-title-image"
        src="/assets/images/more-report.png"
        mode="widthFix"
        aria-label="更多测评"
      />
    </view>
    <view
      wx:for="{{moreReports}}"
      wx:key="type_code"
      class="more-card"
      hover-class="content-card--pressed"
    >
      <view class="more-cover" aria-hidden="true"></view>
      <view class="more-copy">
        <text class="more-title">{{item.title}}</text>
        <text class="more-description">{{item.description}}</text>
      </view>
      <button class="more-action">
        <text class="more-action__label">去测试</text>
      </button>
    </view>
  </view>
    </view>
  </scroll-view>
</view>
