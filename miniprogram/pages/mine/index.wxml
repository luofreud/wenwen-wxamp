<!-- pages/mine/index.wxml -->
<view
  wx:if="{{navigationReady}}"
  class="mine-page"
>
  <view
    class="navigation-bar"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <image
      class="navigation-title"
      src="/assets/images/title-bar.png"
      mode="scaleToFill"
      aria-label="问问星座"
    />
  </view>

  <view wx:if="{{isProfileLoading}}" class="profile-card profile-card--loading">
    <view class="profile-skeleton profile-skeleton--avatar"></view>
    <view class="profile-skeleton-copy">
      <view class="profile-skeleton profile-skeleton--name"></view>
      <view class="profile-skeleton profile-skeleton--tip"></view>
    </view>
  </view>

  <view wx:elif="{{profileError}}" class="profile-card profile-card--error">
    <view class="profile-error-icon">!</view>
    <view class="profile-copy">
      <text class="profile-name profile-name--error">资料暂时没有加载出来</text>
      <text class="profile-message">{{profileError}}</text>
    </view>
    <button class="profile-retry" bindtap="retryProfile">重试</button>
  </view>

  <button
    wx:elif="{{isProfileEmpty}}"
    class="profile-card profile-card--authorize"
    open-type="getUserInfo"
    bindgetuserinfo="handleGetUserInfo"
    loading="{{isProfileUpdating}}"
    disabled="{{isProfileUpdating}}"
    hover-class="profile-card--pressed"
  >
    <view class="avatar-wrap">
      <image
        class="avatar"
        src="/assets/images/avatar.png"
        mode="aspectFit"
        aria-label="默认头像"
      />
    </view>
    <view class="profile-copy">
      <text class="profile-name">同步微信资料</text>
      <text class="profile-message">授权头像和昵称，完善你的星友身份</text>
    </view>
  </button>

  <view wx:else class="profile-card">
    <view class="avatar-wrap">
      <image
        class="avatar avatar--user"
        src="{{profile.avatar || '/assets/images/avatar.png'}}"
        mode="aspectFill"
        aria-label="用户头像"
      />
    </view>
    <view class="profile-copy">
      <text class="profile-name">{{profile.nickname || '星友'}}</text>
      <view
        wx:if="{{profileZodiac}}"
        class="profile-tip profile-tip--{{profileZodiacTone}}"
      >
        <image
          class="profile-zodiac-icon"
          src="{{profileZodiacIcon}}"
          mode="aspectFit"
          aria-label="{{profileZodiac}}图标"
        />
        <text class="profile-zodiac-name">{{profileZodiac}}</text>
      </view>
      <text wx:else class="profile-message">欢迎来到问问星座</text>
    </view>
    <button
      wx:if="{{needsWechatInfo}}"
      class="profile-sync"
      open-type="getUserInfo"
      bindgetuserinfo="handleGetUserInfo"
      loading="{{isProfileUpdating}}"
      disabled="{{isProfileUpdating}}"
    >同步资料</button>
  </view>

  <view class="mine-content-panel">
  <view class="checkin-card">
    <image
      class="checkin-card__background"
      src="/assets/images/check-background.png"
      mode="widthFix"
      aria-hidden="true"
    />
    <view class="checkin-card__content">
    <view class="checkin-head">
      <image
        class="checkin-title-image"
        src="/assets/images/check-title.png"
        mode="scaleToFill"
        aria-label="签到领奖励，连续签到7日可以获得额外奖励"
      />
      <view
        wx:if="{{isCheckInLoading}}"
        class="checkin-button checkin-button--skeleton"
        aria-hidden="true"
      ></view>
      <button
        wx:else
        class="checkin-button {{checkInStatus && checkInStatus.has_checked_in ? 'checkin-button--done' : ''}}"
        hover-class="checkin-button--pressed"
        loading="{{isCheckingIn}}"
        disabled="{{isCheckInLoading || !checkInStatus || isCheckingIn || checkInStatus.has_checked_in}}"
        bindtap="submitCheckIn"
      >{{isCheckingIn ? '签到中' : (checkInStatus && checkInStatus.has_checked_in ? '已签到' : '立即签到')}}</button>
    </view>

    <view wx:if="{{isCheckInLoading}}" class="checkin-loading">
      <view wx:for="{{[1, 2, 3, 4, 5, 6, 7, 8]}}" wx:key="*this" class="checkin-loading__day"></view>
    </view>

    <view wx:elif="{{checkInError}}" class="checkin-error">
      <text class="checkin-error__text">{{checkInError}}</text>
      <button class="checkin-retry" bindtap="retryCheckInStatus">重新加载</button>
    </view>

    <block wx:elif="{{checkInStatus}}">
      <view class="checkin-grid">
        <view
          wx:for="{{checkInDays}}"
          wx:key="cycle_day"
          class="day-card {{item.isCurrent ? 'day-card--today' : ''}} {{item.isChecked ? 'day-card--checked' : ''}} {{item.isSeventh && !item.isChecked ? 'day-card--bonus' : ''}}"
          data-can-check-in="{{item.isCurrent && !checkInStatus.has_checked_in}}"
          bindtap="handleCycleDayTap"
          role="button"
          aria-label="{{item.isChecked ? '第' + item.cycle_day + '天，已完成签到' : item.label + '，奖励' + item.reward_star_coins + '星币'}}"
        >
          <block wx:if="{{item.isChecked}}">
            <text class="day-label">第{{item.cycle_day}}天</text>
            <image
              class="day-checked-icon"
              src="/assets/images/check-done.png"
              mode="aspectFit"
              aria-hidden="true"
            />
          </block>
          <block wx:elif="{{!item.isSeventh}}">
            <text class="day-label">{{item.label}}</text>
            <view class="coin-reward">
              <image
                class="coin"
                src="/assets/icons/start-coin.png"
                mode="aspectFit"
                aria-hidden="true"
              />
              <text class="reward-number">+{{item.reward_star_coins}}</text>
            </view>
          </block>
          <block wx:else>
            <view class="bonus-coin">
              <text class="day-label">{{item.label}}</text>
              <view class="coin-reward">
                <image
                  class="coin"
                  src="/assets/icons/start-coin.png"
                  mode="aspectFit"
                  aria-hidden="true"
                />
                <text class="reward-number">+{{item.reward_star_coins}}</text>
              </view>
            </view>
            <view class="bonus-coupon">
              <image
                class="gift"
                src="/assets/icons/gift.png"
                mode="aspectFit"
                aria-hidden="true"
              />
              <text class="coupon-text">额外奖励</text>
              <text class="coupon-extra">+{{item.bonusRewardStarCoins}} 星币</text>
            </view>
          </block>
        </view>
      </view>
    </block>
    </view>
  </view>

  <view wx:if="{{isCheckInLoading}}" class="milestone-card milestone-card--skeleton" aria-hidden="true"></view>

  <view wx:elif="{{nextMilestone}}" class="milestone-card">
    <view class="milestone-copy">
      <text class="milestone-title">再签到 {{nextMilestone.remainingDays}} 天解锁</text>
      <text class="milestone-reward">额外 +{{nextMilestone.reward_star_coins}} 星币</text>
    </view>
    <view class="milestone-track">
      <view class="milestone-fill" style="width: {{nextMilestone.progressPercent}}%;"></view>
    </view>
  </view>

  <view class="feature-grid">
    <block wx:if="{{isProfileLoading || isCheckInLoading}}">
      <view
        wx:for="{{[1, 2]}}"
        wx:key="*this"
        class="feature-card feature-card--skeleton"
        aria-hidden="true"
      ></view>
    </block>

    <block wx:else>
      <navigator
        class="feature-card feature-card--profile"
        url="/pages/archives/index"
        hover-class="feature-card--pressed"
      >
        <image
          class="feature-card__background"
          src="/assets/images/archive-background-01.png"
          mode="widthFix"
          aria-hidden="true"
        />
        <view class="feature-card__content">
          <image
            class="feature-icon"
            src="/assets/images/archive-icon-01.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <view class="feature-copy">
            <text class="feature-title">个人档案</text>
            <text class="feature-subtitle">完善出生信息</text>
          </view>
        </view>
      </navigator>

      <navigator
        class="feature-card feature-card--report"
        url="/pages/reports/list"
        hover-class="feature-card--pressed"
      >
        <image
          class="feature-card__background"
          src="/assets/images/archive-background-02.png"
          mode="widthFix"
          aria-hidden="true"
        />
        <view class="feature-card__content">
          <image
            class="feature-icon"
            src="/assets/images/archive-icon-02.png"
            mode="aspectFit"
            aria-hidden="true"
          />
          <view class="feature-copy">
            <text class="feature-title">我的报告</text>
            <text class="feature-subtitle">查看星座解读</text>
          </view>
        </view>
      </navigator>
    </block>
  </view>
  </view>
</view>
