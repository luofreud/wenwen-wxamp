<!-- pages/mine/index.wxml -->
<view
  wx:if="{{navigationReady}}"
  class="mine-page"
>
  <view
    class="navigation-bar"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <image
      class="navigation-title"
      src="/assets/images/title-bar.png"
      mode="scaleToFill"
      aria-label="问问星座"
    />
  </view>

  <view wx:if="{{isProfileLoading}}" class="profile-card profile-card--loading">
    <view class="profile-skeleton profile-skeleton--avatar"></view>
    <view class="profile-skeleton-copy">
      <view class="profile-skeleton profile-skeleton--name"></view>
      <view class="profile-skeleton profile-skeleton--tip"></view>
    </view>
  </view>

  <view wx:elif="{{profileError}}" class="profile-card profile-card--error">
    <view class="profile-error-icon">!</view>
    <view class="profile-copy">
      <text class="profile-name profile-name--error">资料暂时没有加载出来</text>
      <text class="profile-tip">{{profileError}}</text>
    </view>
    <button class="profile-retry" bindtap="retryProfile">重试</button>
  </view>

  <button
    wx:elif="{{isProfileEmpty}}"
    class="profile-card profile-card--authorize"
    open-type="getUserInfo"
    bindgetuserinfo="handleGetUserInfo"
    loading="{{isProfileUpdating}}"
    disabled="{{isProfileUpdating}}"
    hover-class="profile-card--pressed"
  >
    <view class="avatar-wrap">
      <image
        class="avatar"
        src="/assets/images/avatar.png"
        mode="aspectFit"
        aria-label="默认头像"
      />
    </view>
    <view class="profile-copy">
      <text class="profile-name">同步微信资料</text>
      <text class="profile-tip">授权头像和昵称，完善你的星友身份</text>
    </view>
  </button>

  <view wx:else class="profile-card">
    <view class="avatar-wrap">
      <image
        class="avatar avatar--user"
        src="{{profile.avatar || '/assets/images/avatar.png'}}"
        mode="aspectFill"
        aria-label="用户头像"
      />
    </view>
    <view class="profile-copy">
      <text class="profile-name">{{profile.nickname || '星友'}}</text>
      <text class="profile-tip">{{profileZodiac ? '星座 · ' + profileZodiac : '欢迎来到问问星座'}}</text>
    </view>
    <button
      wx:if="{{needsWechatInfo}}"
      class="profile-sync"
      open-type="getUserInfo"
      bindgetuserinfo="handleGetUserInfo"
      loading="{{isProfileUpdating}}"
      disabled="{{isProfileUpdating}}"
    >同步资料</button>
  </view>

  <view class="checkin-card">
    <view class="checkin-head">
      <view class="checkin-heading">
        <view class="reward-icon" aria-hidden="true">
          <view class="reward-icon__spark">✦</view>
        </view>
        <view class="checkin-copy">
          <text class="checkin-title">签到领奖励</text>
          <text wx:if="{{checkInStatus}}" class="checkin-subtitle">连续签到 {{checkInStatus.consecutive_days}} 天 · 累计 {{checkInStatus.total_days}} 天</text>
          <text wx:else class="checkin-subtitle">每天签到，积攒属于你的星光</text>
        </view>
      </view>
      <view wx:if="{{checkInStatus}}" class="balance-chip">
        <text class="balance-chip__star">★</text>
        <text>{{checkInStatus.star_coin_balance}}</text>
      </view>
    </view>

    <view wx:if="{{isCheckInLoading}}" class="checkin-loading">
      <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="checkin-loading__day"></view>
    </view>

    <view wx:elif="{{checkInError}}" class="checkin-error">
      <text class="checkin-error__text">{{checkInError}}</text>
      <button class="checkin-retry" bindtap="retryCheckInStatus">重新加载</button>
    </view>

    <block wx:elif="{{checkInStatus}}">
      <view class="checkin-progress">
        <text>第 {{checkInStatus.reward_round}} 轮</text>
        <text wx:if="{{nextMilestone}}">下个目标 · 连续 {{nextMilestone.target_day}} 天</text>
        <text wx:elif="{{hasRewardMilestones}}">本轮里程碑已达成</text>
        <text wx:else>长期进度 {{checkInStatus.reward_progress_day}}/{{checkInStatus.reward_round_length}}</text>
      </view>

      <view wx:if="{{nextMilestone}}" class="milestone-card">
        <view class="milestone-copy">
          <text class="milestone-title">再签到 {{nextMilestone.remainingDays}} 天解锁</text>
          <text class="milestone-reward">额外 +{{nextMilestone.reward_star_coins}} 星币</text>
        </view>
        <view class="milestone-track">
          <view class="milestone-fill" style="width: {{nextMilestone.progressPercent}}%;"></view>
        </view>
      </view>

      <view class="checkin-grid">
        <view
          wx:for="{{checkInDays}}"
          wx:key="cycle_day"
          class="day-card {{item.isCurrent ? 'day-card--today' : ''}} {{item.isChecked ? 'day-card--checked' : ''}} {{item.isSeventh ? 'day-card--bonus' : ''}}"
          data-can-check-in="{{item.isCurrent && !checkInStatus.has_checked_in}}"
          bindtap="handleCycleDayTap"
          role="button"
          aria-label="{{item.label}}，奖励{{item.reward_star_coins}}星币"
        >
          <block wx:if="{{!item.isSeventh}}">
            <text class="day-label">{{item.label}}</text>
            <view class="coin" aria-hidden="true"><text>★</text></view>
            <text class="reward-number">+{{item.reward_star_coins}}</text>
          </block>
          <block wx:else>
            <view class="bonus-coin">
              <text class="day-label">{{item.label}}</text>
              <view class="coin coin--large" aria-hidden="true"><text>★</text></view>
              <text class="reward-number">+{{item.reward_star_coins}}</text>
            </view>
            <view class="bonus-coupon">
              <view class="gift" aria-hidden="true">
                <view class="gift__bow"></view>
                <view class="gift__box"></view>
              </view>
              <text class="coupon-text">额外奖励</text>
              <text class="coupon-extra">+{{item.bonusRewardStarCoins}} 星币</text>
            </view>
          </block>
        </view>
      </view>

      <button
        class="checkin-button checkin-button--wide {{checkInStatus.has_checked_in ? 'checkin-button--done' : ''}}"
        hover-class="checkin-button--pressed"
        loading="{{isCheckingIn}}"
        disabled="{{isCheckingIn || checkInStatus.has_checked_in}}"
        bindtap="submitCheckIn"
      >{{isCheckingIn ? '签到中' : (checkInStatus.has_checked_in ? '今日已签到' : '立即签到 · +' + checkInStatus.today_reward_star_coins + ' 星币')}}</button>
    </block>
  </view>

  <view class="notice-banner">
    <view class="notice-icon" aria-hidden="true">!</view>
    <text class="notice-text">连续签到达成里程碑，还可获得额外星币奖励</text>
    <view class="notice-arrow" aria-hidden="true"></view>
  </view>

  <view class="feature-grid">
    <navigator
      class="feature-card feature-card--profile"
      url="/pages/archives/index"
      hover-class="feature-card--pressed"
    >
      <view class="feature-icon feature-icon--folder" aria-hidden="true">
        <view class="folder-shape"></view>
      </view>
      <view class="feature-copy">
        <text class="feature-title">个人档案</text>
        <text class="feature-subtitle">完善出生信息</text>
      </view>
      <view class="feature-arrow" aria-hidden="true"></view>
    </navigator>

    <view class="feature-card feature-card--report" hover-class="feature-card--pressed">
      <view class="feature-icon feature-icon--report" aria-hidden="true">
        <view class="report-shape">
          <view class="report-line report-line--long"></view>
          <view class="report-line"></view>
        </view>
      </view>
      <view class="feature-copy">
        <text class="feature-title">我的报告</text>
        <text class="feature-subtitle">查看星座解读</text>
      </view>
      <view class="feature-arrow" aria-hidden="true"></view>
    </view>
  </view>
</view>
