<!-- pages/live-preview/index.wxml -->
<view class="live-preview-page">
  <view wx:if="{{isLoading}}" class="detail-card detail-card--loading">
    <view class="preview-skeleton preview-skeleton--poster"></view>
    <view class="preview-skeleton-body">
      <view class="preview-skeleton preview-skeleton--title"></view>
      <view class="preview-skeleton preview-skeleton--copy"></view>
      <view class="preview-skeleton preview-skeleton--copy preview-skeleton--short"></view>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="preview-state">
    <view class="preview-state__orbit">!</view>
    <text class="preview-state__title">这场直播暂时无法打开</text>
    <text class="preview-state__copy">{{loadError}}</text>
    <button wx:if="{{eventNo}}" class="preview-state__button" bindtap="retryLoad">重新加载</button>
    <button class="preview-state__button preview-state__button--ghost" bindtap="goBack">返回首页</button>
  </view>

  <view wx:else class="detail-card">
    <view class="poster">
      <view class="poster-orbit poster-orbit--large"></view>
      <view class="poster-orbit poster-orbit--small"></view>
      <view class="poster-spark poster-spark--one">✦</view>
      <view class="poster-spark poster-spark--two">✦</view>
      <view class="poster-spark poster-spark--three">·</view>

      <view class="poster-center">
        <view class="poster-title">
          <text class="poster-title__accent">星象</text>
          <text class="poster-title__main">直播间</text>
        </view>
        <text class="poster-tag">{{liveEvent.host_name}} · LIVE</text>
      </view>

      <view class="poster-footer">
        <view class="poster-ribbon">
          <text>问问星座</text>
          <text>特别直播</text>
        </view>
        <text class="poster-footer__copy">{{liveEvent.display_time_text}}</text>
      </view>
    </view>

    <view class="live-info">
      <text class="live-title">{{liveEvent.title}}</text>
      <text class="live-description">{{liveEvent.description}}</text>

      <view class="dashed-divider"></view>

      <view class="meta-list">
        <view class="meta-row">
          <text class="meta-label">直播时间：</text>
          <text class="meta-value" user-select="true">{{liveEvent.display_time_text}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">直播嘉宾：</text>
          <text class="meta-value">{{liveEvent.host_name}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">预约人数：</text>
          <text class="meta-value meta-value--count">{{liveEvent.reservation_count}} 人已预约</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">直播链接：</text>
          <text class="meta-value meta-value--link" user-select="true">{{liveEvent.h5_url}}</text>
        </view>
      </view>
    </view>

    <view class="notice-copy">
      <text class="notice-copy__accent">预约直播后，</text>
      <text>如已授权订阅消息，将在开播前收到提醒；拒绝授权不会影响预约。</text>
    </view>

    <view class="action-area">
      <button
        class="action-button action-button--reserve {{liveEvent.reservation_status === 'reserved' ? 'action-button--reserved' : ''}}"
        hover-class="action-button--pressed"
        loading="{{isReserving}}"
        disabled="{{isReserving || liveEvent.reservation_status === 'reserved'}}"
        bindtap="reserveLiveEvent"
      >{{isReserving ? '预约中' : (liveEvent.reservation_status === 'reserved' ? '已预约' : '预约直播')}}</button>
      <button
        class="action-button action-button--share"
        hover-class="action-button--pressed"
        open-type="share"
      >分享直播</button>
    </view>
  </view>
</view>
