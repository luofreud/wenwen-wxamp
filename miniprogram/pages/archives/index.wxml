<!-- pages/archives/index.wxml -->
<view wx:if="{{navigationReady}}" class="archives-page">
  <view
    class="custom-navigation"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <image
      class="navigation-brand"
      src="/assets/images/title-bar.png"
      mode="aspectFit"
      aria-label="问问星座"
    />
  </view>

  <view class="archive-toolbar">
    <navigator
      class="back-action"
      open-type="navigateBack"
      delta="1"
      hover-class="navigation-action--pressed"
      aria-label="返回"
    >
      <view class="back-icon"></view>
    </navigator>
    <text class="navigation-title">我的档案</text>
    <navigator
      class="add-action"
      url="/pages/archives/edit"
      hover-class="navigation-action--pressed"
    >添加档案</navigator>
  </view>

  <view wx:if="{{showHint && archives.length > 0}}" class="swipe-hint">
    <text class="swipe-hint__text">向左滑动档案卡片可以删除</text>
    <view
      class="close-action"
      bindtap="dismissHint"
      hover-class="close-action--pressed"
      role="button"
      aria-label="关闭提示"
    >
      <view class="close-icon"></view>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="archive-list archive-list--loading">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="archive-skeleton">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-orbit state-orbit--error">!</view>
    <text class="state-title">档案暂时没有加载出来</text>
    <text class="state-copy">{{loadError}}</text>
    <button class="state-button" bindtap="retryLoad">重新加载</button>
  </view>
  
  <view wx:elif="{{archives.length === 0}}" class="archive-empty">
    <archive-empty />
  </view>

  <view wx:else class="archive-list">
    <mp-slideview
      wx:for="{{archives}}"
      wx:key="id"
      class="archive-slideview"
      buttons="{{item.slideButtons}}"
      disable="{{deletingArchiveId !== null}}"
      duration="{{260}}"
      rebounce="{{6}}"
      bindbuttontap="requestDeleteArchive"
    >
      <view
        class="archive-card archive-card--slide"
        data-id="{{item.id}}"
        bindtap="editArchive"
        hover-class="archive-card--pressed"
        role="button"
        aria-label="编辑{{item.name}}档案"
      >
        <view class="archive-copy">
          <view class="archive-heading">
            <view class="archive-identity">
              <text class="archive-name">{{item.name}}</text>
              <text class="archive-relation">（{{item.remark || item.genderLabel}}）</text>
            </view>
            <view class="zodiac-tag {{item.zodiacName === '白羊座' || item.zodiacName === '射手座' ? 'zodiac-tag--red' : item.zodiacName === '金牛座' || item.zodiacName === '狮子座' ? 'zodiac-tag--orange' : item.zodiacName === '双子座' || item.zodiacName === '处女座' ? 'zodiac-tag--green' : item.zodiacName === '天秤座' || item.zodiacName === '天蝎座' || item.zodiacName === '双鱼座' ? 'zodiac-tag--purple' : 'zodiac-tag--blue'}}">
              <image
                class="zodiac-icon"
                src="{{item.zodiacIcon}}"
                mode="aspectFit"
                aria-hidden="true"
              />
              <text>{{item.zodiacName}}</text>
            </view>
          </view>
          <text class="archive-date">{{item.birthTimeText}}</text>
        </view>
        <view
          class="edit-action"
          data-id="{{item.id}}"
          catchtap="editArchive"
          hover-class="edit-action--pressed"
          role="button"
          aria-label="编辑{{item.name}}档案"
        >
          <image
            class="edit-icon"
            src="/assets/icons/delete.png"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
      </view>
    </mp-slideview>
  </view>
</view>
