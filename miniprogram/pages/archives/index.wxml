<!-- pages/archives/index.wxml -->
<view wx:if="{{navigationReady}}" class="archives-page">
  <view
    class="custom-navigation"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <view
      class="navigation-content"
      style="padding-right: {{navigationRightPadding}}px;"
    >
      <navigator
        class="back-action"
        open-type="navigateBack"
        delta="1"
        hover-class="navigation-action--pressed"
        aria-label="返回"
      >
        <view class="back-icon"></view>
      </navigator>
      <text class="navigation-title">我的档案</text>
      <navigator
        class="add-action"
        url="/pages/archives/edit"
        hover-class="navigation-action--pressed"
      >添加档案</navigator>
    </view>
  </view>

  <view wx:if="{{showHint && archives.length > 0}}" class="swipe-hint">
    <text class="swipe-hint__text">向左滑动档案卡片可以删除</text>
    <view
      class="close-action"
      bindtap="dismissHint"
      hover-class="close-action--pressed"
      role="button"
      aria-label="关闭提示"
    >
      <view class="close-icon"></view>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="archive-list archive-list--loading">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="archive-skeleton">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-orbit state-orbit--error">!</view>
    <text class="state-title">档案暂时没有加载出来</text>
    <text class="state-copy">{{loadError}}</text>
    <button class="state-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{archives.length === 0}}" class="state-card state-card--empty">
    <view class="state-orbit">✦</view>
    <text class="state-title">建立第一份星象档案</text>
    <text class="state-copy">记录出生时间与地点，开启属于你的星盘故事。</text>
    <navigator class="state-button" url="/pages/archives/edit">添加档案</navigator>
  </view>

  <view wx:else class="archive-list">
    <scroll-view
      wx:for="{{archives}}"
      wx:key="id"
      class="swipe-archive"
      scroll-x="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-with-animation="{{true}}"
      scroll-left="{{item.scrollLeft}}"
      data-id="{{item.id}}"
      bindscroll="handleArchiveScroll"
      bindtouchend="settleArchiveSwipe"
    >
      <view class="swipe-track">
        <view
          class="archive-card archive-card--swipe"
          data-id="{{item.id}}"
          bindtap="editArchive"
          hover-class="archive-card--pressed"
          role="button"
          aria-label="编辑{{item.name}}档案"
        >
          <view class="archive-copy">
            <view class="archive-heading">
              <text class="archive-name">{{item.name}}</text>
              <text class="archive-relation">{{item.genderLabel}}</text>
              <view class="zodiac-tag zodiac-tag--{{item.zodiacTone}}">
                <text class="zodiac-symbol">{{item.zodiacSymbol}}</text>
                <text>{{item.zodiacName}}</text>
              </view>
            </view>
            <text class="archive-date">{{item.birthTimeText}}</text>
            <text class="archive-place">{{item.birthPlace}} · UTC{{item.timezone >= 0 ? '+' : ''}}{{item.timezone}}</text>
          </view>
          <view
            class="edit-action"
            data-id="{{item.id}}"
            catchtap="editArchive"
            hover-class="edit-action--pressed"
            role="button"
            aria-label="编辑{{item.name}}档案"
          >
            <view class="edit-icon"></view>
          </view>
        </view>
        <view
          class="delete-action {{deletingArchiveId === item.id ? 'delete-action--loading' : ''}}"
          data-id="{{item.id}}"
          bindtap="requestDeleteArchive"
          hover-class="delete-action--pressed"
          role="button"
          aria-label="删除{{item.name}}的档案"
        >
          <text>{{deletingArchiveId === item.id ? '删除中' : '删除'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
