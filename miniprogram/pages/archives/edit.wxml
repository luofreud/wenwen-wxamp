<!-- pages/archives/edit.wxml -->
<view wx:if="{{navigationReady}}" class="archive-edit-page">
  <view
    class="custom-navigation"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <view class="navigation-content">
      <navigator
        class="back-action"
        open-type="navigateBack"
        delta="1"
        hover-class="back-action--pressed"
        aria-label="返回"
      >
        <view class="back-icon"></view>
      </navigator>
      <text class="navigation-title">{{pageTitle}}</text>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="form-loading">
    <view wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this" class="form-loading__line"></view>
  </view>

  <view wx:elif="{{loadError}}" class="form-state">
    <view class="form-state__icon">!</view>
    <text class="form-state__title">无法编辑这份档案</text>
    <text class="form-state__copy">{{loadError}}</text>
    <button class="form-state__button" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <view class="form-card">
      <view class="form-item">
        <text class="field-label field-label--required">姓名</text>
        <input
          class="field-input"
          value="{{name}}"
          placeholder="请填写"
          placeholder-class="field-placeholder"
          maxlength="{{nameMaxLength}}"
          bindinput="handleNameInput"
        />
      </view>

      <view class="form-item">
        <text class="field-label field-label--required">性别</text>
        <view class="gender-options">
          <view
            class="gender-option {{gender === 2 ? 'gender-option--female-active' : ''}}"
            data-gender="2"
            bindtap="selectGender"
            hover-class="gender-option--pressed"
            role="radio"
            aria-checked="{{gender === 2}}"
          >
            <image
              class="gender-icon"
              src="/assets/icons/female-icon.png"
              mode="aspectFit"
              aria-hidden="true"
            />
            <text>女生</text>
          </view>
          <view
            class="gender-option {{gender === 1 ? 'gender-option--male-active' : ''}}"
            data-gender="1"
            bindtap="selectGender"
            hover-class="gender-option--pressed"
            role="radio"
            aria-checked="{{gender === 1}}"
          >
            <image
              class="gender-icon"
              src="/assets/icons/male-icon.png"
              mode="aspectFit"
              aria-hidden="true"
            />
            <text>男生</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="field-label field-label--required">出生时间</text>
        <view class="birth-datetime">
          <picker
            class="birth-picker birth-picker--date"
            mode="date"
            value="{{birthDate}}"
            start="{{dateStart}}"
            end="{{dateEnd}}"
            bindchange="handleBirthDateChange"
            aria-label="选择出生日期"
          >
            <view class="birth-picker__value">
              <text class="selector-text {{birthDate ? 'field-value' : 'field-placeholder'}}">{{birthDate || '选择日期'}}</text>
              <view class="selector-arrow"></view>
            </view>
          </picker>

          <picker
            class="birth-picker birth-picker--time"
            mode="time"
            value="{{birthTime}}"
            bindchange="handleBirthTimeChange"
            aria-label="选择出生时间"
          >
            <view class="birth-picker__value">
              <text class="selector-text {{birthTime ? 'field-value' : 'field-placeholder'}}">{{birthTime || '选择时间'}}</text>
              <view class="selector-arrow"></view>
            </view>
          </picker>
        </view>
      </view>

      <city-cascade-picker
        label="出生地点"
        placeholder="请选择"
        variant="form"
        required="{{true}}"
        value="{{birthLocationId}}"
        location="{{birthLocation}}"
        bindchange="handleBirthLocationChange"
      />

      <city-cascade-picker
        label="现居地"
        placeholder="请选择"
        variant="form"
        required="{{true}}"
        value="{{currentLocationId}}"
        location="{{currentLocation}}"
        same-location="{{birthLocation}}"
        bindchange="handleCurrentLocationChange"
      />

      <view
        wx:if="{{timezoneError}}"
        class="form-item"
        bindtap="handleTimezoneTap"
        hover-class="form-item--pressed"
        role="button"
        aria-label="时区加载失败，点击重试"
      >
        <text class="field-label field-label--required">时区</text>
        <view class="field-selector">
          <text class="selector-text field-placeholder">{{timezoneLabel}}</text>
          <view class="selector-arrow"></view>
        </view>
      </view>

      <picker
        wx:else
        class="field-picker"
        mode="selector"
        range="{{timezoneOptions}}"
        range-key="label"
        value="{{timezoneIndex}}"
        disabled="{{isTimezoneLoading || timezoneOptions.length === 0}}"
        bindchange="handleTimezoneChange"
      >
        <view class="form-item">
          <text class="field-label field-label--required">时区</text>
          <view class="field-selector">
            <text class="selector-text {{timezoneOptions.length > 0 ? 'field-value' : 'field-placeholder'}}">{{timezoneLabel}}</text>
            <view class="selector-arrow"></view>
          </view>
        </view>
      </picker>

      <view class="form-item">
        <text class="field-label">夏令时</text>
        <view class="switch-wrap">
          <switch
            checked="{{daylightSaving}}"
            color="#4A148C"
            bindchange="handleDaylightSavingChange"
            aria-label="夏令时"
          />
        </view>
      </view>

      <view class="form-item form-item--last">
        <text class="field-label">备注</text>
        <input
          class="field-input"
          value="{{remark}}"
          placeholder="如：本人、伴侣（选填）"
          placeholder-class="field-placeholder"
          maxlength="{{remarkMaxLength}}"
          bindinput="handleRemarkInput"
        />
      </view>
    </view>

    <view class="submit-area">
      <button
        class="submit-button {{isSubmitting ? 'submit-button--loading' : ''}}"
        hover-class="submit-button--pressed"
        loading="{{isSubmitting}}"
        disabled="{{isSubmitting}}"
        bindtap="submitArchive"
      >{{isSubmitting ? '保存中' : (archiveId === null ? '创建档案' : '保存修改')}}</button>
    </view>
  </block>
</view>
