<!-- pages/archives/switch.wxml -->
<view wx:if="{{navigationReady}}" class="switch-page">
  <view
    class="custom-navigation"
    style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;"
  >
    <view
      class="navigation-content"
      style="padding-right: {{navigationRightPadding}}px;"
    >
      <navigator
        class="back-action"
        open-type="navigateBack"
        delta="1"
        hover-class="navigation-action--pressed"
        aria-label="返回"
      >
        <view class="back-icon"></view>
      </navigator>
      <text class="navigation-title">切换档案</text>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="archive-list">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="archive-card archive-card--skeleton">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-symbol">!</view>
    <text class="state-title">档案暂时没有加载出来</text>
    <text class="state-copy">{{loadError}}</text>
    <button class="state-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{archives.length === 0}}" class="archive-empty">
    <view class="empty-symbol">＋</view>
    <text class="empty-title">还没有档案</text>
    <text class="empty-copy">添加一份档案后，就可以在这里选择</text>
  </view>

  <view wx:else class="archive-list">
    <view
      wx:for="{{archives}}"
      wx:key="id"
      class="archive-card {{item.isSelected ? 'archive-card--selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectArchive"
      hover-class="archive-card--pressed"
      role="button"
      aria-label="{{item.isSelected ? '已选择' : '选择'}}{{item.name}}"
    >
      <view class="archive-copy">
        <view class="archive-heading">
          <view class="archive-identity">
            <text class="archive-name">{{item.name}}</text>
            <text class="archive-relation">（{{item.remark || item.genderLabel}}）</text>
          </view>
          <view class="zodiac-tag {{item.zodiacTagClass}}">
            <image
              class="zodiac-icon"
              src="{{item.zodiacIcon}}"
              mode="aspectFit"
              aria-hidden="true"
            />
            <text>{{item.zodiacName}}</text>
          </view>
        </view>
        <text class="archive-date">{{item.birthTimeText}}</text>
      </view>
      <view class="selection-control" aria-hidden="true">
        <view wx:if="{{item.isSelected}}" class="selection-check"></view>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button
      class="bottom-button bottom-button--add"
      hover-class="bottom-button--pressed"
      disabled="{{isConfirming}}"
      bindtap="addArchive"
    >添加档案</button>
    <button
      class="bottom-button bottom-button--confirm"
      hover-class="bottom-button--pressed"
      loading="{{isConfirming}}"
      disabled="{{isLoading || archives.length === 0 || selectedArchiveId === null || isConfirming}}"
      bindtap="confirmSelection"
    >确认选择</button>
  </view>
</view>
