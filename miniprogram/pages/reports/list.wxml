<!-- pages/reports/list.wxml -->
<view class="reports-page">
  <view wx:if="{{reports.length > 0}}" class="report-list">
    <view
      wx:for="{{reports}}"
      wx:key="id"
      class="more-card"
      data-id="{{item.id}}"
      bindtap="openReport"
      hover-class="more-card--pressed"
      role="button"
      aria-label="查看{{item.title}}"
    >
      <image class="more-cover" src="{{item.cover}}" mode="aspectFill" aria-hidden="true" />
      <view class="more-copy">
        <text class="more-title">{{item.title}}</text>
        <text class="more-description">{{item.description}}</text>
      </view>
      <button
        class="more-action"
        data-id="{{item.id}}"
        catchtap="openReport"
        aria-label="查看{{item.title}}"
      >
        <text class="more-action__label">查看报告</text>
      </button>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-state__title">暂无报告</text>
    <text class="empty-state__description">完成测评后，生成的报告会展示在这里</text>
  </view>
</view>
